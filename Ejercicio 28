Algoritmo llenar_matriz
	definir i,j Como Entero
	Dimension notas[3,2]
	
	Para i <- 1 Hasta 3 Hacer
		para j <- 1 Hasta 2 Hacer
			Escribir "ingrese notas de alumno ", i," en el curso ", j, ":"
			leer notas[i,j]
		FinPara
	FinPara
	
	para i <- 1 hasta 3 Hacer
		Para j <- 1 hasta 2 Hacer
			Escribir Sin Saltar notas[i,j], " "
			
		FinPara
		
	Escribir " "
	FinPara
	
	
FinAlgoritmo
