Algoritmo BuscarMayorMenor
	Dimension notas[3,2]
	definir Mayor, Menor Como Real
	definir i,j Como Entero
	
	Para i <- 1 Hasta 3 Hacer
		para j <- 1 Hasta 2 Hacer
			Escribir "ingrese notas de alumno ", i," en el curso ", j, ":"
			leer notas[i,j]
			Escribir " "
		FinPara
	FinPara
	
	Mayor <- notas[1,1]
	Menor <- notas[1,1]
	
	para i<- 1  Hasta 3 Hacer
		para j <- 1 Hasta 2 Hacer
			si (notas[i,j] > Mayor) Entonces
				Mayor <- notas[i,j]
			FinSi
			si (notas[i,j] < Menor) Entonces
				Menor <- notas[i,j]
			FinSi
		FinPara
	FinPara
	
	Escribir "La nota mayor: ", Mayor
	Escribir "la nota menor: ", Menor
FinAlgoritmo
