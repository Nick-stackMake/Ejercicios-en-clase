Algoritmo Suma_Columna
	Dimension notas[3,2]
	definir suma, promedio Como Real
	definir i,j Como Entero
	
	Para i <- 1 Hasta 3 Hacer
		para j <- 1 Hasta 2 Hacer
			Escribir "ingrese notas de alumno ", i," en el curso ", j, ":"
			leer notas[i,j]
			Escribir " "
		FinPara
	FinPara
	
	suma <- 0 
	para i <- 1 hasta 3 Hacer
		suma <- suma + notas[i,1]
	FinPara
	
	promedio <- suma / 3 
	
	Escribir "la suma de las notas del curso 1 es ", suma
	Escribir "El promedio del examen 1 es ", promedio
	Escribir " "
	suma <- 0 
	para i <- 1 hasta 3 Hacer
		suma <- suma + notas[i,2]
	FinPara
	
	promedio <- suma / 3
	
	Escribir "la suma de las notas del curso 2 es ", suma
	Escribir "El promedio del examen 2 es ", promedio
	
FinAlgoritmo
